---
import "../styles/global.css";
import { site } from "../config/site";
import MotionEngine from "../components/MotionEngine.astro";

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  lang?: string;
  // Open Graph tags are emitted only when a page passes `og`.
  og?: { image?: string; locale?: string; type?: string };
  // Extra class on <html>, e.g. "tutoring" for the warm light/dark palette.
  theme?: string;
  // hreflang alternates for translated pages.
  alternates?: { lang: string; href: string }[];
}
const { title, description = "Embedded systems × applied AI — firmware, protocol archaeology, control theory, and learning algorithms.", noindex = false, lang = "en", og, theme, alternates = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang={lang} class={theme}>
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.add("js");</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <title>{title}</title>
    {
      og && (
        <>
          <link rel="canonical" href={canonical} />
          <meta property="og:type" content={og.type ?? "website"} />
          <meta property="og:title" content={title} />
          <meta property="og:description" content={description} />
          <meta property="og:url" content={canonical} />
          {og.locale && <meta property="og:locale" content={og.locale} />}
          {og.image && <meta property="og:image" content={new URL(og.image, Astro.site)} />}
        </>
      )
    }
    <link rel="sitemap" href="/sitemap-index.xml" />
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={new URL(a.href, Astro.site)} />)}
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-100 focus:rounded-md focus:bg-surface focus:px-4 focus:py-2 focus:text-sm"
    >
      {lang === "fr" ? "Aller au contenu" : "Skip to content"}
    </a>

    <header class="sticky top-0 z-50 border-b border-border bg-bg/70 backdrop-blur-md">
      <div class="mx-auto flex h-14 max-w-[1100px] items-center justify-between px-6">
        <a href="/" class="font-mono text-sm"><span class="text-accent">~/</span>{site.handle}</a>
        {Astro.slots.has("nav") ? <slot name="nav" /> : (
        <nav class="flex items-center gap-6" aria-label="Main">
          <a href="/#work" class="hidden text-sm text-muted transition-colors hover:text-foreground sm:block">Work</a>
          <a href="/#research" class="hidden text-sm text-muted transition-colors hover:text-foreground sm:block">Research</a>
          <a href="/#exhibits" class="hidden text-sm text-muted transition-colors hover:text-foreground sm:block">Exhibits</a>
          <a
            href="/cv/"
            class="rounded-md bg-foreground px-3.5 py-1.5 text-sm font-medium text-bg transition-opacity hover:opacity-85"
          >
            For Employers
          </a>
        </nav>
        )}
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="mt-32 border-t border-border py-12">
      <div class="mx-auto flex max-w-[1100px] flex-wrap items-center justify-between gap-6 px-6">
        <p class="font-mono text-xs text-faint">
          ~/{site.handle} · powered by caffeine, curiosity, and occasional chaos
        </p>
        <div class="flex flex-wrap gap-6">
          <slot name="footer" />
          <a href={site.github} class="text-sm text-muted hover:text-foreground">GitHub</a>
          <a href="/projects/" class="text-sm text-muted hover:text-foreground">Projects</a>
          <a href="/cv/" class="text-sm text-muted hover:text-foreground">CV</a>
        </div>
      </div>
    </footer>

    <MotionEngine />

    <script>
      // Scroll reveals — reveal once at 12% visibility. CSS handles reduced motion.
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add("in");
              io.unobserve(e.target);
            }
          }
        },
        { threshold: 0.12 },
      );
      document.querySelectorAll(".reveal:not(.in)").forEach((el) => io.observe(el));
    </script>
  </body>
</html>
