---
import Base from "../../layouts/Base.astro";
import { getCollection, render } from "astro:content";
import "katex/dist/katex.min.css";

export async function getStaticPaths() {
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  return posts.map((entry) => ({
    params: { slug: entry.id.replace(/\.md$/, "") },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const fmt = (d: Date) =>
  d.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" });
---

<Base title={`${entry.data.title} — abysse8`} description={entry.data.blurb}>
  <article class="mx-auto max-w-[70ch] px-6 pt-24 pb-8">
    <a href="/posts/" class="font-mono text-xs text-accent hover:underline">← Posts</a>
    <header class="mt-4 mb-8">
      <p class="font-mono text-[0.7rem] tracking-[0.06em] text-faint uppercase">
        {fmt(entry.data.date)}
      </p>
      <h1 class="mt-2 text-[clamp(1.7rem,3.5vw,2.4rem)] leading-tight font-bold tracking-[-0.02em] text-balance">
        {entry.data.title}
      </h1>
      <div class="mt-4 flex flex-wrap gap-1.5">
        {
          entry.data.tags.map((t) => (
            <span class="rounded-full border border-border px-2 py-0.5 font-mono text-[0.66rem] text-faint">
              {t}
            </span>
          ))
        }
      </div>
    </header>

    <div class="post-body">
      <Content />
    </div>

    {
      entry.data.code && (
        <p class="mt-10 border-t border-border pt-6">
          <a
            href={entry.data.code}
            class="inline-flex items-center gap-2 rounded-md border border-border bg-surface px-4 py-2 font-mono text-sm text-foreground transition-colors hover:border-border-strong"
          >
            ↓ download the script
          </a>
        </p>
      )
    }
  </article>
</Base>

<style is:global>
  .post-body {
    color: var(--color-muted, #b8b8c0);
    font-size: 1.02rem;
    line-height: 1.75;
  }
  .post-body > * + * { margin-top: 1.15rem; }
  .post-body h2 {
    color: var(--color-foreground, #ededf2);
    font-size: 1.4rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    margin-top: 2.4rem;
    margin-bottom: 0.2rem;
  }
  .post-body strong { color: var(--color-foreground, #ededf2); font-weight: 600; }
  .post-body a { color: var(--color-accent, #c98500); text-decoration: underline; }
  .post-body img {
    width: 100%;
    border-radius: 0.75rem;
    border: 1px solid var(--color-border, #2a2a31);
    margin: 1.5rem 0;
  }
  .post-body em { color: var(--color-faint, #8a8a93); }
  .post-body table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
    display: block;
    overflow-x: auto;
  }
  .post-body th, .post-body td {
    border: 1px solid var(--color-border, #2a2a31);
    padding: 0.5rem 0.7rem;
    text-align: left;
  }
  .post-body th { color: var(--color-foreground, #ededf2); font-weight: 600; }
  .post-body pre {
    background: var(--color-surface, #16161a);
    border: 1px solid var(--color-border, #2a2a31);
    border-radius: 0.6rem;
    padding: 1rem;
    overflow-x: auto;
    font-size: 0.82rem;
    line-height: 1.5;
  }
  .post-body code {
    font-family: ui-monospace, monospace;
    font-size: 0.9em;
  }
  .post-body :not(pre) > code {
    background: var(--color-surface, #16161a);
    border-radius: 0.3rem;
    padding: 0.1rem 0.35rem;
  }
</style>
