---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";

// Drafts never build (same gate as ideas). Newest first.
const posts = (await getCollection("posts", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const fmt = (d: Date) =>
  d.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" });
---

<Base
  title="Posts — abysse8"
  description="Short teaching threads on signal processing, compression, and the mathematics I find beautiful — each one a single idea, made concrete."
>
  <div class="mx-auto max-w-[1100px] px-6 pt-24">
    <header class="mb-12 max-w-[62ch]">
      <p class="font-mono text-xs tracking-[0.08em] text-accent uppercase">Room 08 — Posts</p>
      <h1 class="mt-3 mb-4 text-[clamp(2rem,4vw,2.8rem)] font-bold tracking-[-0.025em] text-balance">
        Stories of mathematics.
      </h1>
      <p class="text-[1.05rem] text-muted">
        Short threads, each built around one idea and one figure I generated from scratch — signal
        processing, compression, the theorems I find beautiful. Written to be read by a curious
        stranger, not graded by a committee.
      </p>
    </header>

    {
      posts.length === 0 ? (
        <p class="rounded-xl border border-dashed border-border bg-surface p-8 text-center font-mono text-sm text-faint">
          Nothing published yet.
        </p>
      ) : (
        <ul class="grid gap-4 sm:grid-cols-2">
          {posts.map((p) => (
            <li>
              <a
                href={`/posts/${p.id.replace(/\.md$/, "")}/`}
                class="group flex h-full flex-col overflow-hidden rounded-xl border border-border bg-surface transition-colors hover:border-border-strong"
              >
                {p.data.hero && (
                  <img
                    src={p.data.hero}
                    alt=""
                    loading="lazy"
                    class="aspect-[16/9] w-full object-cover opacity-90 transition-opacity group-hover:opacity-100"
                  />
                )}
                <div class="flex flex-1 flex-col p-5">
                  <p class="font-mono text-[0.68rem] tracking-[0.06em] text-faint uppercase">
                    {fmt(p.data.date)}
                  </p>
                  <h2 class="mt-2 mb-2 text-[1.15rem] leading-snug font-semibold tracking-[-0.015em] text-foreground">
                    {p.data.title}
                  </h2>
                  <p class="mb-4 text-[0.92rem] text-muted">{p.data.blurb}</p>
                  <div class="mt-auto flex flex-wrap gap-1.5">
                    {p.data.tags.map((t) => (
                      <span class="rounded-full border border-border px-2 py-0.5 font-mono text-[0.66rem] text-faint">
                        {t}
                      </span>
                    ))}
                  </div>
                </div>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</Base>
