---
import Base from "../layouts/Base.astro";
import { site } from "../config/site";

const instagram = { handle: "@lj.gzs", href: "https://www.instagram.com/lj.gzs/" };
const questionnaire = "https://tally.so/r/zxakRg";

const githubProjects = [
  {
    title: "CoverGemini",
    tag: "IA appliquée · dépôt public",
    description: "Une offre d'emploi devient un CV LaTeX sur mesure en 30 s : iOS → Gemini → Flask → PDF. L'IA qui fait gagner du temps réel, pas en théorie.",
    href: "https://github.com/abysse8/CoverGemini",
  },
  {
    title: "Contrôleur universel d'afficheurs — SVT",
    tag: "Projet interne · code propriétaire",
    description: "Boîtier unique (ESP32, C/C++) pilotant trois familles d'afficheurs de bus derrière une interface logicielle commune. Travail d'études SVT — démo sur demande.",
    href: site.github,
  },
  {
    title: "Reporting automatisé — SVT",
    tag: "Projet interne · SVT Communication",
    description: "Pipeline Flask + React transformant les données d'intervention en rapports techniques livrés au client. Code propriétaire (démo sur demande).",
    href: site.github,
  },
];

// Every quote below is copied word for word from the document named in `source`.
const RI = "Règlement intérieur apprenants, 1er juillet 2026";
const planks = [
  {
    title: "Une IA claire, utile et enseignée",
    body: "Quand l’enseignant n’a rien précisé, l’IA est interdite par défaut, et un usage non autorisé est traité comme un plagiat. Sans consigne claire, on peut être sanctionné pour avoir utilisé un outil. Je demanderai que chaque module annonce dès le départ ce qui est autorisé, et que la formation IA promise arrive vraiment jusqu’à nous.",
    quotes: [
      { label: "Charte IA CESI", source: "Charte IA CESI", text: "La règle par défaut est la suivante : en l'absence de consigne explicite de l'enseignant, l'usage de l'IAG est interdit. […] Tout recours non autorisé sera considéré comme une atteinte à l'intégrité académique et sanctionné au même titre qu'un plagiat" },
    ],
  },
  {
    title: "Des formats qui tiennent compte des trajets",
    body: "Pour ceux qui vivent loin, je demanderai que chaque séance précise ce qui peut être préparé ou suivi à distance : supports accessibles, consignes anticipées, visioconférence quand le format s’y prête. Le présentiel reste la règle, et filmer un cours demande une autorisation : je ne promets pas de captations.",
    quotes: [
      { label: "Article 20", source: RI, text: "Il est formellement interdit, sauf dérogation expresse, d'enregistrer ou de filmer les séances de formation." },
    ],
  },
  {
    title: "Une représentation qui remonte les faits",
    body: "Le délégué ne change pas une note et ne vote pas à la place du jury. Il y est invité, avec une voix consultative : il peut parler, et doit arriver avec des faits. Je veux un point de contact simple et régulier entre la classe et l’équipe pédagogique, avec un suivi écrit de ce qui a été remonté.",
    quotes: [
      { label: "Annexe 2 · jurys campus", source: "Règlement des études Programme Grande École, septembre 2026", text: "Le(s) représentant(s) du service scolarité du campus ainsi que les délégués de la formation sont membres invités" },
      { label: "Annexe 2 · délibérations", source: "Règlement des études Programme Grande École, septembre 2026", text: "Seuls les membres du jury ont une voix délibérative. Les invités au jury ont une voix consultative." },
    ],
  },
  {
    title: "Égalité des chances, dans la pratique",
    body: "L’égalité passe d’abord par l’accès à l’information : savoir à qui écrire, et comment. Une réclamation écrite à la qualité est un droit prévu par le règlement. Je ferai connaître ces canaux, et j’aiderai à formuler une demande quand quelqu’un le souhaite, en toute confidentialité.",
    quotes: [
      { label: "Article 23", source: RI, text: "les personnes en formation peuvent porter réclamation éventuelle par mail à qualite@cesi.fr en précisant le nom du campus, la formation suivie et le motif de l'insatisfaction." },
    ],
  },
  {
    title: "Face à une sanction, une présence et des droits",
    body: "Convoqué à un entretien disciplinaire, on peut se faire assister par un autre apprenant : je serai disponible. Le délégué est aussi invité à la commission de discipline. La décision doit être écrite et motivée, et un recours est possible sous 15 jours. Personne ne devrait découvrir ces droits trop tard.",
    quotes: [
      { label: "Article 28-2", source: RI, text: "L'apprenant peut se faire assister, au cours de l'entretien, par une personne de son choix : apprenant ou salarié de l'établissement." },
      { label: "Article 28-2", source: RI, text: "Sont invités à participer à la Commission de discipline, avec voix consultative : le délégué des élèves de la promotion" },
      { label: "Article 28-3", source: RI, text: "la décision du conseil de discipline peut faire l'objet d'une demande de recours adressée par courrier auprès du service national de la scolarité, dans un délai de 15 jours à compter de la réception du courrier de notification de la décision." },
    ],
  },
];

// Rules that cost apprentices days or pay when nobody knows them.
const goodToKnow = [
  { label: "Article 17-5", title: "Plus d’une heure de retard = demi-journée d’absence", text: "Au-delà de soixante minutes, l'apprenant n'est plus considéré comme retardataire mais comme absent sur la demi-journée concernée." },
  { label: "Article 17-3", title: "48 heures pour justifier une absence", text: "L'apprenant doit prévenir l'établissement de son absence et doit déposer un justificatif sur la plate-forme dédiée dans les 48 heures." },
  { label: "Absences à la demande de l’entreprise", title: "L’entreprise ne peut pas vous sortir des cours", text: "Les contraintes de fonctionnement de l'entreprise, les réunions internes, déplacements professionnels, séminaires, missions, périodes de forte activité ou impératifs de production ne constituent pas, par eux-mêmes, des motifs recevables d'absence sur le temps de formation." },
];
---

<Base
  title="Julien Gonzales — Candidature délégué"
  description="Julien Gonzales, candidat délégué FISA A3 S3E. Des positions appuyées sur le règlement, un questionnaire d'une minute, le vote vendredi 9 octobre."
>
  <div class="campaign-shell">
    <section class="campaign-hero">
      <div class="hero-photo">
        <img src="/delegue-julien.jpg" alt="Julien Gonzales" width="800" height="1000" />
        <div class="campaign-poster" aria-label="Informations sur le scrutin">
          <span class="poster-label">Le scrutin</span>
          <strong>Ven. 9 oct.</strong>
          <strong>13:30—16:30</strong>
          <span>Salle N1 - 113 Lyon</span>
        </div>
      </div>
      <div class="hero-copy">
        <p class="campaign-kicker">Candidat délégué · FISA A3 S3E · 2026—2029</p>
        <h1>Julien<br />Gonzales</h1>
        <p class="campaign-lede">Je construis des systèmes, j’écoute les problèmes jusqu’au bout, et je préfère une demande précise, appuyée sur le règlement, à une promesse vague.</p>
        <div class="campaign-actions">
          <a href={questionnaire} class="campaign-button campaign-button-primary">Le questionnaire · 2 min ↗</a>
          <a href="#positions" class="campaign-button campaign-button-ghost">Mes positions ↓</a>
          <a href={instagram.href} class="campaign-button campaign-button-ghost">{instagram.handle} ↗</a>
        </div>
      </div>
    </section>

    <section class="campaign-intro">
      <p class="campaign-section-label">Pourquoi moi</p>
      <div class="campaign-intro-copy">
        <h2>Pas un porte-parole qui <mark>disparaît après le vote.</mark></h2>
        <div>
          <p>Je veux représenter la classe avec une méthode simple : écouter, vérifier dans les textes, synthétiser, puis revenir avec une réponse. Mon expérience en communication chez SVT et mes projets d’ingénierie m’ont appris à faire le lien entre un besoin de terrain et une solution qui fonctionne vraiment.</p>
          <p>Ce site en est un exemple : mon CV, mes projets et mes réflexions sont publics. Vous pouvez regarder ce que je construis avant de décider.</p>
          <a href="/cv" class="inline-link">Mon parcours complet (CV) →</a>
        </div>
      </div>
    </section>

    <section id="role" class="campaign-role">
      <p class="campaign-section-label">Ce qu’est un délégué, et ce qu’il peut vraiment faire</p>
      <div class="role-intro">
        <h2>Une voix dans la salle, <mark>pas une voix au vote.</mark></h2>
        <p>Le délégué est l’étudiant élu pour représenter la promotion auprès de l’école. Aucun texte CESI ne définit ses missions : il n’y apparaît qu’à deux endroits, comme invité. Tout le reste (recueillir les problèmes, les documenter, les porter à l’équipe pédagogique, suivre la réponse) dépend de celui qui occupe le poste.</p>
      </div>
      <div class="role-cols">
        <div>
          <h3 class="role-head">Ce que le délégué a, selon les textes</h3>
          <div class="position-quotes">
            <blockquote class="rule-quote">
              <span class="rule-label">Jurys campus</span>
              <p>« Le(s) représentant(s) du service scolarité du campus ainsi que les délégués de la formation sont membres invités »</p>
              <cite>Règlement des études Programme Grande École, septembre 2026, annexe 2</cite>
            </blockquote>
            <blockquote class="rule-quote">
              <span class="rule-label">Voix consultative</span>
              <p>« Seuls les membres du jury ont une voix délibérative. Les invités au jury ont une voix consultative. »</p>
              <cite>Règlement des études Programme Grande École, septembre 2026, annexe 2</cite>
            </blockquote>
            <blockquote class="rule-quote">
              <span class="rule-label">Commission de discipline</span>
              <p>« Sont invités à participer à la Commission de discipline, avec voix consultative : le délégué des élèves de la promotion »</p>
              <cite>Règlement intérieur apprenants, art. 28-2</cite>
            </blockquote>
          </div>
        </div>
        <div>
          <h3 class="role-head">Ce qu’il n’a pas</h3>
          <div class="position-quotes">
            <blockquote class="rule-quote rule-limit">
              <span class="rule-label">Pas de vote, pas de décision finale</span>
              <p>« Les décisions du jury national sont les décisions finales qui seront communiquées aux entreprises et aux apprentis. »</p>
              <cite>Règlement des études Programme Grande École, septembre 2026, §8. Le délégué n’est invité qu’aux jurys campus.</cite>
            </blockquote>
            <blockquote class="rule-quote rule-limit">
              <span class="rule-label">Confidentialité</span>
              <p>« Tous les participants au jury sont soumis à l'obligation de réserve et de confidentialité quant aux délibérations rendues lors des réunions du jury. »</p>
              <cite>Règlement des études Programme Grande École, septembre 2026, annexe 2. Ce qui se dit au jury ne se répète pas à la classe.</cite>
            </blockquote>
            <blockquote class="rule-quote rule-limit">
              <span class="rule-label">Conseil de perfectionnement</span>
              <p>« Les membres du conseil de perfectionnement sont désignés par le Conseil d'administration. »</p>
              <cite>Règlement intérieur apprenants, art. 24. Le délégué n’y siège pas.</cite>
            </blockquote>
          </div>
        </div>
      </div>
      <p class="role-note">Deux droits souvent attribués au délégué appartiennent en fait à tout le monde : se faire assister lors d’un entretien disciplinaire par un autre apprenant (art. 28-2), et écrire une réclamation à qualite@cesi.fr (art. 23). Mon travail, c’est de les faire connaître.</p>
    </section>

    <section id="positions" class="campaign-positions">
      <p class="campaign-section-label">Mes positions, et ce que dit le texte</p>
      <div class="position-list">
        {planks.map((plank) => (
          <article class="position-card">
            <div class="position-claim">
              <h3>{plank.title}</h3>
              <p>{plank.body}</p>
            </div>
            <div class="position-quotes">
              {plank.quotes.map((q) => (
                <blockquote class="rule-quote">
                  <span class="rule-label">{q.label}</span>
                  <p>« {q.text} »</p>
                  <cite>{q.source}</cite>
                </blockquote>
              ))}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="campaign-know">
      <p class="campaign-section-label">Ce que vous ne savez peut-être pas</p>
      <div class="know-grid">
        {goodToKnow.map((k) => (
          <blockquote class="rule-quote know-card">
            <span class="rule-label">{k.label}</span>
            <h3>{k.title}</h3>
            <p>« {k.text} »</p>
            <cite>{RI}</cite>
          </blockquote>
        ))}
      </div>
    </section>

    <section class="campaign-proof">
      <p class="campaign-section-label">Ce que je construis déjà</p>
      <div class="campaign-proof-grid">
        <div>
          <h2>L’IA n’est pas un slogan <mark>pour moi.</mark></h2>
          <p>Chez SVT Communication, elle m’aide à passer plus vite de l’idée à un outil utilisable : automatiser, structurer, tester et rendre le résultat transmissible. Le but n’est jamais de remplacer le jugement humain, mais de libérer du temps pour mieux réfléchir et mieux faire.</p>
          <a class="inline-link" href={site.github}>Explorer GitHub ↗</a>
        </div>
        <div class="project-stack">
          {githubProjects.map((project) => (
            <a class="mini-project" href={project.href}>
              <span class="mini-project-tag">{project.tag}</span>
              <strong>{project.title} <span>↗</span></strong>
              <p>{project.description}</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="campaign-listen">
      <p class="campaign-section-label">À vous de parler</p>
      <div class="campaign-listen-grid">
        <div>
          <h2>Avant de parler <mark>en votre nom.</mark></h2>
          <p>D’abord un classement de six sujets, puis trois questions courtes. Chaque réponse est enregistrée dès que tu la valides : tu peux t’arrêter quand tu veux. Aucun nom ni e-mail demandé. Je partagerai les résultats bruts avec la promo.</p>
          <a class="campaign-button campaign-button-primary" href={questionnaire}>Répondre au questionnaire ↗</a>
        </div>
        <ol class="listen-card">
          <li><span class="rule-label">1 · Classement</span>Dans quel ordre le délégué devrait-il traiter ces sujets ?</li>
          <li><span class="rule-label">2 · Facultatif</span>Quelle amélioration concrète voudrais-tu demander au CESI ?</li>
          <li><span class="rule-label">3 · Facultatif</span>Sur quelles règles ou démarches aimerais-tu une explication claire ?</li>
          <li><span class="rule-label">4 · Facultatif</span>Après qu’un sujet a été remonté, quel retour te serait le plus utile ?</li>
        </ol>
      </div>
    </section>

    <section class="campaign-close">
      <p class="campaign-kicker">Une question, un problème, une idée ?</p>
      <h2>Parlons-en <mark>avant vendredi.</mark></h2>
      <div class="campaign-actions campaign-actions-center">
        <a class="campaign-button campaign-button-primary" href={`mailto:${site.email}?subject=Pour la promotion`}>M’écrire ↗</a>
        <a class="campaign-button campaign-button-ghost" href={instagram.href}>{instagram.handle} ↗</a>
      </div>
    </section>
  </div>
</Base>
